# The parallel stack uses Fyers market data and paper execution.
# Leave empty for every F&O stock underlying plus the configured indices.
# Set a comma-separated list only to narrow the universe.
MACD_SYMBOLS_CSV=
MACD_TIMEFRAME_SECONDS=60

# Optional Fyers market-data credentials. You can also enter these in Settings.
MACD_FYERS_CLIENT_ID=
MACD_FYERS_SECRET=
MACD_FYERS_ACCESS_TOKEN=

# Retired US Paper Desk keys; used only when the optional "us" profile is enabled.
US_FINNHUB_API_KEY=
US_ALPHA_VANTAGE_API_KEY=

# Extra browser origins allowed on the engine stream socket (loopback is always allowed).
MACD_ALLOWED_ORIGINS_CSV=

# Stream fan-out in the Go gateway ("off" tunnels the socket to the engine as before).
STREAM_FANOUT=on
# Store raw ticks in QuestDB for 5 days ("off" keeps only 1-minute bars).
QUESTDB_STORE_TICKS=on
# Live analytics worker shards; empty uses the CPU count (2 to 8).
LIVE_WORKERS=
# Optional API token, shared by the engine, gateway and analytics.
MACD_API_TOKEN=
